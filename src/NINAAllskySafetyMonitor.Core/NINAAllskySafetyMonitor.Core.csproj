<Project Sdk="Microsoft.NET.Sdk">
  <!-- All safety logic. Must not reference NINA (see design CL-01). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>NINAAllskySafetyMonitor.Core</RootNamespace>
    <AssemblyName>NINAAllskySafetyMonitor.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NINAAllskySafetyMonitor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- SFTP from the Allsky Pi (Ed25519 keys, host-key fingerprint check).
         2026.0.0 fixes GHSA-mggc-4xg6-vcxf and GHSA-q939-rpr3-3284 (both in the SCP client, which is not used).
         Brings BouncyCastle.Cryptography and Microsoft.Extensions.Logging.Abstractions. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bright star catalogue embedded at build time (added during code generation). -->
    <EmbeddedResource Include="Resources\**\*" Exclude="Resources\**\.gitkeep" />
  </ItemGroup>
</Project>
