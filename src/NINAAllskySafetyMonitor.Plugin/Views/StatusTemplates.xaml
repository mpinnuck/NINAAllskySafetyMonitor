<ResourceDictionary
    x:Class="NINAAllskySafetyMonitor.Plugin.Views.StatusTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:oxy="http://oxyplot.org/wpf">

    <BooleanToVisibilityConverter x:Key="AllskySafety_BoolToVisibility" />

    <!--  Key = fully qualified view-model type name + "_Dockable" (NINA convention)  -->
    <DataTemplate x:Key="NINAAllskySafetyMonitor.Plugin.ViewModels.StatusViewModel_Dockable">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8">
                <Border Padding="10,6" CornerRadius="4">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#7A1F1F" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSafe}" Value="True">
                                    <Setter Property="Background" Value="#1F6B33" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAssumed}" Value="True">
                                    <Setter Property="Background" Value="#8A6200" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                    <Setter Property="Background" Value="#444444" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{Binding StateText}" />
                </Border>
                <Border
                    Margin="0,6,0,0"
                    Padding="8,4"
                    Background="#B36B00"
                    CornerRadius="3"
                    Visibility="{Binding OverrideActive, Converter={StaticResource AllskySafety_BoolToVisibility}}">
                    <TextBlock
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{Binding OverrideBanner}"
                        TextWrapping="Wrap" />
                </Border>
                <Border
                    Margin="0,6,0,0"
                    Padding="8,4"
                    Background="#7A4A00"
                    CornerRadius="3"
                    Visibility="{Binding DaylightTestModeVisible, Converter={StaticResource AllskySafety_BoolToVisibility}}">
                    <TextBlock
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{Binding DaylightTestModeText}"
                        TextWrapping="Wrap" />
                </Border>
                <TextBlock
                    Margin="0,8,0,0"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="{Binding ReasonText}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="15"
                    Opacity="0.8"
                    Foreground="#E0E000"
                    Text="{Binding CloudAdvisoryText}"
                    TextWrapping="Wrap"
                    Visibility="{Binding CloudAdvisoryVisible, Converter={StaticResource AllskySafety_BoolToVisibility}}" />
                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="18"
                    FontWeight="Bold"
                    Text="{Binding CountdownText}" />
                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="14"
                    Opacity="0.7"
                    Text="{Binding LastUpdateText}" />
                <TextBlock
                    Margin="0,8,0,0"
                    FontSize="15"
                    Foreground="Orange"
                    Text="UNTUNED — cloud thresholds are conservative defaults"
                    TextWrapping="Wrap"
                    Visibility="{Binding UntunedVisible, Converter={StaticResource AllskySafety_BoolToVisibility}}" />
                <Image
                    Margin="0,8,0,0"
                    MaxHeight="480"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Cursor="Hand"
                    Source="{Binding AllskyImage}"
                    ToolTip="Click to enlarge"
                    Stretch="Uniform"
                    Visibility="{Binding HasImage, Converter={StaticResource AllskySafety_BoolToVisibility}}" >
                    <Image.InputBindings>
                        <MouseBinding Command="{Binding OpenViewerCommand}" Gesture="LeftClick" />
                    </Image.InputBindings>
                </Image>
                <TextBlock
                    Margin="0,8,0,2"
                    FontWeight="Bold"
                    Text="Tonight"
                    Visibility="{Binding IsConnected, Converter={StaticResource AllskySafety_BoolToVisibility}}" />
                <oxy:PlotView
                    Height="170"
                    Background="Transparent"
                    Model="{Binding History.Model}"
                    Visibility="{Binding IsConnected, Converter={StaticResource AllskySafety_BoolToVisibility}}" />
                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Text="Show working area, ROI and stars" />
                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding ShowOverlay}" />
                </StackPanel>
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Text="Override" />
                    <ComboBox
                        MinWidth="120"
                        ItemsSource="{Binding OverrideModes}"
                        SelectedItem="{Binding OverrideMode}" />
                </StackPanel>
                <StackPanel Margin="0,8,0,0">
                    <StackPanel.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="Foreground" Value="#D0D8E0" />
                            <Setter Property="Opacity" Value="0.95" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </StackPanel.Resources>
                    <TextBlock FontWeight="Bold" Text="{Binding WeatherInfoText}" />
                    <TextBlock Margin="0,2,0,0" Text="{Binding RoiInfoText}" />
                    <TextBlock Margin="0,2,0,0" FontWeight="Bold" Text="{Binding MountInfoText}" />
                    <StackPanel Margin="0,4,0,0" Visibility="{Binding Metrics.HasMetrics, Converter={StaticResource AllskySafety_BoolToVisibility}}">
                        <TextBlock FontWeight="Bold" Text="{Binding Metrics.StarsText}" />
                        <TextBlock Margin="0,2,0,0" FontWeight="Bold" Text="{Binding Metrics.BrightnessText}" />
                        <TextBlock Margin="0,2,0,0" FontWeight="Bold" Text="{Binding Metrics.MoonText}" />
                        <TextBlock Margin="0,2,0,0" Opacity="0.85" Text="{Binding Metrics.ReferenceText}" />
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" Text="{Binding ImageInfoText}" />
                    <TextBlock Margin="0,2,0,0" Opacity="0.85" Text="{Binding OverlayLegendText}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
