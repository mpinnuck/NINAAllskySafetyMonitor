<ResourceDictionary
    x:Class="NINAAllskySafetyMonitor.Plugin.Views.StatusTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <BooleanToVisibilityConverter x:Key="AllskySafety_BoolToVisibility" />

    <!--  Key = fully qualified view-model type name + "_Dockable" (NINA convention)  -->
    <DataTemplate x:Key="NINAAllskySafetyMonitor.Plugin.ViewModels.StatusViewModel_Dockable">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8">
                <Border Padding="10,6" CornerRadius="4">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#7A1F1F" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSafe}" Value="True">
                                    <Setter Property="Background" Value="#1F6B33" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                    <Setter Property="Background" Value="#444444" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{Binding StateText}" />
                </Border>
                <Border
                    Margin="0,6,0,0"
                    Padding="8,4"
                    Background="#B36B00"
                    CornerRadius="3"
                    Visibility="{Binding OverrideActive, Converter={StaticResource AllskySafety_BoolToVisibility}}">
                    <TextBlock
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{Binding OverrideBanner}"
                        TextWrapping="Wrap" />
                </Border>
                <TextBlock
                    Margin="0,8,0,0"
                    Text="{Binding ReasonText}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,4,0,0"
                    FontWeight="Bold"
                    Text="{Binding CountdownText}" />
                <TextBlock
                    Margin="0,4,0,0"
                    Opacity="0.7"
                    Text="{Binding LastUpdateText}" />
                <TextBlock
                    Margin="0,4,0,0"
                    Text="{Binding WeatherInfoText}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,4,0,0"
                    Text="{Binding RoiInfoText}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,4,0,0"
                    Text="{Binding MountInfoText}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,8,0,0"
                    Foreground="Orange"
                    Text="UNTUNED — cloud thresholds are conservative defaults"
                    TextWrapping="Wrap"
                    Visibility="{Binding UntunedVisible, Converter={StaticResource AllskySafety_BoolToVisibility}}" />
                <Image
                    Margin="0,10,0,0"
                    MaxHeight="480"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Source="{Binding AllskyImage}"
                    Stretch="Uniform"
                    Visibility="{Binding HasImage, Converter={StaticResource AllskySafety_BoolToVisibility}}" />
                <TextBlock
                    Margin="0,4,0,0"
                    Opacity="0.7"
                    Text="{Binding ImageInfoText}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="11"
                    Opacity="0.7"
                    Text="{Binding OverlayLegendText}"
                    TextWrapping="Wrap" />
                <CheckBox
                    Margin="0,6,0,0"
                    Content="Show working area and ROI on the image"
                    IsChecked="{Binding ShowOverlay}" />
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Text="Override" />
                    <ComboBox
                        MinWidth="120"
                        ItemsSource="{Binding OverrideModes}"
                        SelectedItem="{Binding OverrideMode}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
