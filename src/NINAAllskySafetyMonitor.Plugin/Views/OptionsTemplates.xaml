<ResourceDictionary
    x:Class="NINAAllskySafetyMonitor.Plugin.Views.OptionsTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Key = plugin name (AssemblyTitle) + "_Options" (NINA convention). DataContext is AllskySafetyPlugin.  -->
    <DataTemplate x:Key="Allsky Safety Monitor_Options">
        <Grid Margin="5" DataContext="{Binding Settings}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="230" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,6" FontWeight="Bold" Text="Operating window" />
            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Active when Sun is below (°)" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" Text="{Binding SunAltitudeLimitDeg}" />
            <TextBlock Grid.Row="1" Grid.Column="2" Margin="8,0" VerticalAlignment="Center" Opacity="0.7" Text="−18 = astronomical twilight; +90 for daytime testing" />

            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Cycle interval (s)" />
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2" Text="{Binding IntervalS}" />

            <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Margin="0,10,0,6" FontWeight="Bold" Text="Fallback site (used when the NINA profile has no location)" />
            <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="Latitude (°, north +)" />
            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,2" Text="{Binding FallbackLatitudeDeg}" />
            <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Text="Longitude (°, east +)" />
            <TextBox Grid.Row="5" Grid.Column="1" Margin="0,2" Text="{Binding FallbackLongitudeDeg}" />
            <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="Elevation (m)" />
            <TextBox Grid.Row="6" Grid.Column="1" Margin="0,2" Text="{Binding FallbackElevationM}" />

            <TextBlock Grid.Row="7" Grid.ColumnSpan="3" Margin="0,10,0,6" FontWeight="Bold" Text="Weather station" />
            <CheckBox Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,2" Content="Check rain and wind" IsChecked="{Binding WeatherEnabled}" />
            <TextBlock Grid.Row="9" Grid.Column="0" VerticalAlignment="Center" Text="Station ID" />
            <TextBox Grid.Row="9" Grid.Column="1" Margin="0,2" Text="{Binding WeatherStationId}" />
            <TextBlock Grid.Row="10" Grid.Column="0" VerticalAlignment="Center" Text="API key (not the device key)" />
            <TextBox Grid.Row="10" Grid.Column="1" Margin="0,2" Text="{Binding WeatherApiKey}" />

            <StackPanel Grid.Row="11" Grid.ColumnSpan="3" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Width="90" Margin="0,0,8,0" Command="{Binding SaveCommand}" Content="Save" />
                    <Button Width="90" Command="{Binding RevertCommand}" Content="Revert" />
                </StackPanel>
                <TextBlock Margin="0,8,0,0" Text="{Binding Message}" TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0" Opacity="0.6" Text="{Binding SettingsFilePath, StringFormat=Settings file: {0}}" />
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
