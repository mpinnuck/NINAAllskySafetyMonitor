<ResourceDictionary
    x:Class="NINAAllskySafetyMonitor.Plugin.Views.OptionsTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:NINAAllskySafetyMonitor.Plugin.Views">

    <!--  Key = plugin name (AssemblyTitle) + "_Options" (NINA convention). DataContext is AllskySafetyPlugin.  -->
    <DataTemplate x:Key="Allsky Safety Monitor_Options">
        <StackPanel Margin="5" DataContext="{Binding Settings}" Grid.IsSharedSizeScope="True">
            <TextBlock Margin="0,0,0,4" FontWeight="Bold" Text="Operating window" />
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Active when Sun is below (°)" />
                <TextBox Grid.Column="1" Text="{Binding SunAltitudeLimitDeg}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="−18 = astronomical twilight; +90 keeps it active in daylight, for testing" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Cycle interval (s)" />
                <TextBox Grid.Column="1" Text="{Binding IntervalS}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="How often a new image is fetched and checked (10–3600). The Allsky camera takes one every 30 s" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Mount check interval (s)" />
                <TextBox Grid.Column="1" Text="{Binding MountPollIntervalS}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="How often the mount is read (1–60). A slew, park or tracking change is checked at once, reusing the latest image" TextWrapping="Wrap" />
            </Grid>
            <TextBlock Margin="0,14,0,4" FontWeight="Bold" Text="Safety decision and log" />
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Safe after clear for (min)" />
                <TextBox Grid.Column="1" Text="{Binding SafeAfterMin}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="Unsafe is reported at once; safe only after every condition has been clear this long" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Keep decision log for (days)" />
                <TextBox Grid.Column="1" Text="{Binding LogRetentionDays}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Decision log folder" />
                <TextBox Grid.Column="1" Text="{Binding LogFolder}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="One CSV file per day, readable by Excel" TextWrapping="Wrap" />
            </Grid>
            <TextBlock Margin="0,14,0,4" FontWeight="Bold" Text="Image source" />
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Source" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding ImageSourceKinds}" SelectedItem="{Binding ImageSourceKind}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="Direct = SFTP from the Allsky Pi (works without internet); Web = Allsky web site" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Fetch timeout (s)" />
                <TextBox Grid.Column="1" Text="{Binding ImageTimeoutS}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="A stalled fetch is abandoned after this time" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Image is stale after (min)" />
                <TextBox Grid.Column="1" Text="{Binding StaleAfterMin}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="Older images are unsafe" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Unsafe when no fetch succeeds for (min)" />
                <TextBox Grid.Column="1" Text="{Binding FetchFailUnsafeMin}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Incomplete image: retry after (s)" />
                <TextBox Grid.Column="1" Text="{Binding IncompleteRetryS}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="An image caught while being written is fetched again" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Incomplete image: attempts" />
                <TextBox Grid.Column="1" Text="{Binding IncompleteRetries}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="" TextWrapping="Wrap" />
            </Grid>
            <TextBlock Margin="0,14,0,4" FontWeight="Bold" Text="Direct (SFTP from the Allsky Pi)" />
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Host" />
                <TextBox Grid.Column="1" Text="{Binding DirectHost}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Fallback IP" />
                <TextBox Grid.Column="1" Text="{Binding DirectFallbackIp}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="Used if the host name cannot be reached" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Port" />
                <TextBox Grid.Column="1" Text="{Binding DirectPort}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="User" />
                <TextBox Grid.Column="1" Text="{Binding DirectUser}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Image path on the Pi" />
                <TextBox Grid.Column="1" Text="{Binding DirectRemotePath}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="SSH key file" />
                <TextBox Grid.Column="1" Text="{Binding DirectKeyFile}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="Private key, for example C:\Users\Mark\.ssh\id_ed25519" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Log in with a password instead" />
                <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding DirectUsePassword}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="Not recommended; the key is preferred" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Password" />
                <PasswordBox Grid.Column="1" views:PasswordBoxAssistant.BoundPassword="{Binding SftpPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Opacity="0.65" Text="{Binding PasswordStatus}" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Host-key type" />
                <TextBox Grid.Column="1" Text="{Binding DirectHostKeyAlgorithm}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="The type the fingerprint belongs to: ecdsa-sha2-nistp256, ssh-ed25519 or rsa-sha2-256" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Pinned host-key fingerprint" />
                <TextBox Grid.Column="1" Text="{Binding DirectHostKeyFingerprint}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="The Pi must present exactly this key" TextWrapping="Wrap" />
            </Grid>
            <TextBlock Margin="0,14,0,4" FontWeight="Bold" Text="Web" />
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Base URL" />
                <TextBox Grid.Column="1" Text="{Binding WebBaseUrl}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="The Allsky web page folder" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Image file name" />
                <TextBox Grid.Column="1" Text="{Binding WebFileName}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="" TextWrapping="Wrap" />
            </Grid>
            <TextBlock Margin="0,14,0,4" FontWeight="Bold" Text="Working area and ROI" />
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Working area centre altitude (°)" />
                <TextBox Grid.Column="1" Text="{Binding WorkingAreaCentreAltDeg}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="Centre of the part of the sky the monitor judges; 75 with azimuth 180 = 15° south of the zenith (0–90)" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Working area centre azimuth (°)" />
                <TextBox Grid.Column="1" Text="{Binding WorkingAreaCentreAzDeg}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="From north through east: 180 = south (0–360)" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Working area radius (°)" />
                <TextBox Grid.Column="1" Text="{Binding WorkingAreaRadiusDeg}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="Radius on the sky (5–90). Sky below the horizon is always excluded" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="ROI radius (°)" />
                <TextBox Grid.Column="1" Text="{Binding RoiRadiusDeg}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="Circle around where the telescope points (1–90)" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Minimum ROI inside working area (%)" />
                <TextBox Grid.Column="1" Text="{Binding RoiMinInsidePercent}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="Below this, the whole working area is judged instead (0–100)" TextWrapping="Wrap" />
            </Grid>
            <TextBlock Margin="0,14,0,4" FontWeight="Bold" Text="Lens calibration" />
            <TextBlock Margin="0,0,0,4" Text="{Binding CalibrationStatusText}" TextWrapping="Wrap" />
            <StackPanel Margin="0,2,0,4" Orientation="Horizontal">
                <Button Width="200" Margin="0,0,8,0" Command="{Binding CalibrateFromFrameCommand}" Content="Calibrate from a frame…" />
                <Button Width="220" Margin="0,0,8,0" Command="{Binding CalibrateFromCurrentImageCommand}" Content="Calibrate from current image" />
                <TextBlock VerticalAlignment="Center" Opacity="0.65" Text="Use a clear, moonless frame. The viewer also draws the working-area outline." TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Margin="0,0,0,4" FontWeight="Bold" Foreground="Orange" Text="{Binding CalibrationMessage}" TextWrapping="Wrap" />
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Warn below matched stars" />
                <TextBox Grid.Column="1" Text="{Binding MinMatchedStars}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="A fit matching fewer stars is reported with a warning (3–500)" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Warn above fit error (°)" />
                <TextBox Grid.Column="1" Text="{Binding MaxFitErrorDeg}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="RMS error on the sky; 0.2° is about 3.5 px on a 2500 px frame (0.01–5)" TextWrapping="Wrap" />
            </Grid>
            <TextBlock Margin="0,14,0,4" FontWeight="Bold" Text="Lens model by hand (optional)" />
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Enter the lens model by hand" />
                <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ManualLensEnabled}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="Off: the calibrated model, or an estimate from the image size until calibrated. On: replaces the calibrated model with these values" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Zenith X (pixels)" />
                <TextBox Grid.Column="1" IsEnabled="{Binding ManualLensEnabled}" Text="{Binding LensCentreX}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="Column of the zenith in the full-size Allsky image" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Zenith Y (pixels)" />
                <TextBox Grid.Column="1" IsEnabled="{Binding ManualLensEnabled}" Text="{Binding LensCentreY}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="Row of the zenith in the full-size Allsky image" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Horizon radius (pixels)" />
                <TextBox Grid.Column="1" IsEnabled="{Binding ManualLensEnabled}" Text="{Binding LensHorizonRadiusPx}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="Distance from the zenith to the horizon in the full-size image" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="North rotation (°)" />
                <TextBox Grid.Column="1" IsEnabled="{Binding ManualLensEnabled}" Text="{Binding LensNorthRotationDeg}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="Angle of north from image up, towards image right (−360 to 360)" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="East clockwise from north" />
                <CheckBox Grid.Column="1" VerticalAlignment="Center" IsEnabled="{Binding ManualLensEnabled}" IsChecked="{Binding LensEastClockwise}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="Off for the usual looking-up view (east to the left of north)" TextWrapping="Wrap" />
            </Grid>
            <TextBlock Margin="0,14,0,4" FontWeight="Bold" Text="Cloud detection" />
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Limiting magnitude" />
                <TextBox Grid.Column="1" Text="{Binding LimitingMagnitude}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="Catalogue stars down to this magnitude are expected in the ROI (0–7)" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Cloud below stars found (%)" />
                <TextBox Grid.Column="1" Text="{Binding MinStarPercent}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="Primary test: fewer of the expected stars found than this means cloud (0–100)" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Minimum expected stars" />
                <TextBox Grid.Column="1" Text="{Binding MinExpectedStars}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="With fewer expected stars the star test is skipped and the brightness test decides (1–500)" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Cloud above brightness (×)" />
                <TextBox Grid.Column="1" Text="{Binding MaxBrightnessRatio}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="ROI brightness relative to the rest of the working area, against the clear-sky reference (1–10)" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Cloud above non-uniformity (×)" />
                <TextBox Grid.Column="1" Text="{Binding MaxUniformityRatio}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="ROI non-uniformity against the clear-sky reference (1–10)" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Moon exclusion (°)" />
                <TextBox Grid.Column="1" Text="{Binding MoonExclusionDeg}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="Stars this close to the Moon are not expected (0–90)" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Thresholds tuned" />
                <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding CloudTuned}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="Tick once the thresholds have been tuned from real nights: clears UNTUNED and lets the clear-sky reference be captured" TextWrapping="Wrap" />
            </Grid>
            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                <Button Width="240" Margin="0,0,8,0" Command="{Binding ClearReferenceCommand}" Content="Clear the clear-sky reference" />
                <TextBlock VerticalAlignment="Center" Text="{Binding ReferenceStatusText}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Margin="0,14,0,4" FontWeight="Bold" Text="Tuning mode" />
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Save every frame and its metrics" />
                <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding TuningEnabled}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="For tuning the thresholds: about 700 MB a night" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Tuning folder" />
                <TextBox Grid.Column="1" Text="{Binding TuningFolder}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="A folder per night with the frames and a CSV of metrics, readable by Excel" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Keep tuning data for (days)" />
                <TextBox Grid.Column="1" Text="{Binding TuningRetentionDays}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="Older nights are deleted (1–365)" TextWrapping="Wrap" />
            </Grid>
            <TextBlock Margin="0,14,0,4" FontWeight="Bold" Text="Fallback site (used when the NINA profile has no location)" />
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Latitude (°, north +)" />
                <TextBox Grid.Column="1" Text="{Binding FallbackLatitudeDeg}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Longitude (°, east +)" />
                <TextBox Grid.Column="1" Text="{Binding FallbackLongitudeDeg}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Elevation (m)" />
                <TextBox Grid.Column="1" Text="{Binding FallbackElevationM}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="" TextWrapping="Wrap" />
            </Grid>
            <TextBlock Margin="0,14,0,4" FontWeight="Bold" Text="Weather station" />
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Check rain and wind" />
                <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding WeatherEnabled}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Station ID" />
                <TextBox Grid.Column="1" Text="{Binding WeatherStationId}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="API key" />
                <TextBox Grid.Column="1" Text="{Binding WeatherApiKey}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="The account API key, not the station upload key" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Poll interval (s)" />
                <TextBox Grid.Column="1" Text="{Binding WeatherPollIntervalS}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="How often the station is read (30–3600)" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Unsafe when gust is above (km/h)" />
                <TextBox Grid.Column="1" Text="{Binding MaxGustKmH}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Weather data is stale after (min)" />
                <TextBox Grid.Column="1" Text="{Binding WeatherStaleAfterMin}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="Older data, or none, is unsafe" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Request timeout (s)" />
                <TextBox Grid.Column="1" Text="{Binding WeatherTimeoutS}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="" TextWrapping="Wrap" />
            </Grid>

            <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                <Button Width="90" Margin="0,0,8,0" Command="{Binding SaveCommand}" Content="Save" />
                <Button Width="90" Margin="0,0,8,0" Command="{Binding RevertCommand}" Content="Revert" />
                <Button Width="110" Command="{Binding TestImageCommand}" Content="Test image" Margin="0,0,8,0" />
                <Button Width="120" Command="{Binding TestWeatherCommand}" Content="Test weather" />
            </StackPanel>
            <TextBlock Margin="0,8,0,0" Text="{Binding Message}" TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0" Opacity="0.6" Text="{Binding SettingsFilePath, StringFormat=Settings file: {0}}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
