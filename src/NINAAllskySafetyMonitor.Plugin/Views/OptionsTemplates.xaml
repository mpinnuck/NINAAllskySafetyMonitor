<ResourceDictionary
    x:Class="NINAAllskySafetyMonitor.Plugin.Views.OptionsTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:NINAAllskySafetyMonitor.Plugin.Views">

    <!--  Key = plugin name (AssemblyTitle) + "_Options" (NINA convention). DataContext is AllskySafetyPlugin.  -->
    <DataTemplate x:Key="Allsky Safety Monitor_Options">
        <StackPanel Margin="5" DataContext="{Binding Settings}" Grid.IsSharedSizeScope="True">
            <TextBlock Margin="0,0,0,4" FontWeight="Bold" Text="Operating window" />
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Active when Sun is below (°)" />
                <TextBox Grid.Column="1" Text="{Binding SunAltitudeLimitDeg}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="−18 = astronomical twilight; +90 keeps it active in daylight, for testing" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Cycle interval (s)" />
                <TextBox Grid.Column="1" Text="{Binding IntervalS}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="How often a new image is fetched and checked (10–3600)" TextWrapping="Wrap" />
            </Grid>
            <TextBlock Margin="0,14,0,4" FontWeight="Bold" Text="Image source" />
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Source" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding ImageSourceKinds}" SelectedItem="{Binding ImageSourceKind}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="Direct = SFTP from the Allsky Pi (works without internet); Web = Allsky web site" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Fetch timeout (s)" />
                <TextBox Grid.Column="1" Text="{Binding ImageTimeoutS}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="A stalled fetch is abandoned after this time" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Image is stale after (min)" />
                <TextBox Grid.Column="1" Text="{Binding StaleAfterMin}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="Older images are unsafe" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Unsafe when no fetch succeeds for (min)" />
                <TextBox Grid.Column="1" Text="{Binding FetchFailUnsafeMin}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Incomplete image: retry after (s)" />
                <TextBox Grid.Column="1" Text="{Binding IncompleteRetryS}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="An image caught while being written is fetched again" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Incomplete image: attempts" />
                <TextBox Grid.Column="1" Text="{Binding IncompleteRetries}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="" TextWrapping="Wrap" />
            </Grid>
            <TextBlock Margin="0,14,0,4" FontWeight="Bold" Text="Direct (SFTP from the Allsky Pi)" />
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Host" />
                <TextBox Grid.Column="1" Text="{Binding DirectHost}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Fallback IP" />
                <TextBox Grid.Column="1" Text="{Binding DirectFallbackIp}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="Used if the host name cannot be reached" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Port" />
                <TextBox Grid.Column="1" Text="{Binding DirectPort}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="User" />
                <TextBox Grid.Column="1" Text="{Binding DirectUser}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Image path on the Pi" />
                <TextBox Grid.Column="1" Text="{Binding DirectRemotePath}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="SSH key file" />
                <TextBox Grid.Column="1" Text="{Binding DirectKeyFile}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="Private key, for example C:\Users\Mark\.ssh\id_ed25519" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Log in with a password instead" />
                <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding DirectUsePassword}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="Not recommended; the key is preferred" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Password" />
                <PasswordBox Grid.Column="1" views:PasswordBoxAssistant.BoundPassword="{Binding SftpPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Opacity="0.65" Text="{Binding PasswordStatus}" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Pinned host-key fingerprint" />
                <TextBox Grid.Column="1" Text="{Binding DirectHostKeyFingerprint}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="The Pi must present exactly this key" TextWrapping="Wrap" />
            </Grid>
            <TextBlock Margin="0,14,0,4" FontWeight="Bold" Text="Web" />
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Base URL" />
                <TextBox Grid.Column="1" Text="{Binding WebBaseUrl}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="The Allsky web page folder" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Image file name" />
                <TextBox Grid.Column="1" Text="{Binding WebFileName}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="" TextWrapping="Wrap" />
            </Grid>
            <TextBlock Margin="0,14,0,4" FontWeight="Bold" Text="Fallback site (used when the NINA profile has no location)" />
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Latitude (°, north +)" />
                <TextBox Grid.Column="1" Text="{Binding FallbackLatitudeDeg}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Longitude (°, east +)" />
                <TextBox Grid.Column="1" Text="{Binding FallbackLongitudeDeg}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Elevation (m)" />
                <TextBox Grid.Column="1" Text="{Binding FallbackElevationM}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="" TextWrapping="Wrap" />
            </Grid>
            <TextBlock Margin="0,14,0,4" FontWeight="Bold" Text="Weather station" />
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Check rain and wind" />
                <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding WeatherEnabled}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="Station ID" />
                <TextBox Grid.Column="1" Text="{Binding WeatherStationId}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="" TextWrapping="Wrap" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="AllskyLabel" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="API key" />
                <TextBox Grid.Column="1" Text="{Binding WeatherApiKey}" />
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="The account API key, not the station upload key" TextWrapping="Wrap" />
            </Grid>

            <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                <Button Width="90" Margin="0,0,8,0" Command="{Binding SaveCommand}" Content="Save" />
                <Button Width="90" Margin="0,0,8,0" Command="{Binding RevertCommand}" Content="Revert" />
                <Button Width="110" Command="{Binding TestImageCommand}" Content="Test image" />
            </StackPanel>
            <TextBlock Margin="0,8,0,0" Text="{Binding Message}" TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0" Opacity="0.6" Text="{Binding SettingsFilePath, StringFormat=Settings file: {0}}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
