<Window
    x:Class="NINAAllskySafetyMonitor.Plugin.Views.ImageViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{Binding Title}"
    Background="#1B1F26"
    Foreground="#E6E8EC"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6E8EC" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6E8EC" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="10,3" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <!--  Layers  -->
        <WrapPanel Margin="8,6" DockPanel.Dock="Top">
            <CheckBox Content="Working area" IsChecked="{Binding ShowWorkingArea}" />
            <CheckBox Content="ROI" IsChecked="{Binding ShowRoi}" />
            <CheckBox Content="N / E / S / W" IsChecked="{Binding ShowCompass}" />
            <CheckBox Content="Alt/az grid" IsChecked="{Binding ShowGrid}" />
            <CheckBox
                Content="Catalogue stars"
                IsChecked="{Binding ShowStars}"
                Visibility="{Binding IsCalibration, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Opacity="0.7"
                Text="Wheel: zoom · drag: pan · double-click: fit to window" />
        </WrapPanel>

        <!--  Calibration controls  -->
        <Border
            Padding="8,6"
            Background="#252A33"
            DataContext="{Binding Calibration}"
            DockPanel.Dock="Top"
            Visibility="{Binding DataContext.IsCalibration, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <WrapPanel>
                    <Button Command="{Binding FitCommand}" Content="Fit" />
                    <TextBlock Margin="10,0,6,0" VerticalAlignment="Center" Text="Identify:" />
                    <ComboBox
                        MinWidth="300"
                        Margin="0,0,8,0"
                        ItemsSource="{Binding NamedStars}"
                        SelectedItem="{Binding SelectedStar}" />
                    <CheckBox Content="Click to place it" IsChecked="{Binding Picking}" />
                    <Button Command="{Binding FitFromPicksCommand}" Content="Fit from identified stars" />
                    <Button Command="{Binding ClearPicksCommand}" Content="Clear identified" />
                    <CheckBox Margin="14,0,14,0" Content="Draw outline" IsChecked="{Binding Drawing}" />
                    <Button Command="{Binding ClearOutlineCommand}" Content="Clear outline" />
                    <Button Margin="24,0,8,0" Command="{Binding SaveCommand}" Content="Save" />
                    <Button Command="{Binding CancelCommand}" Content="Cancel" />
                </WrapPanel>
                <TextBlock Margin="0,6,0,0" Text="{Binding Status}" TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,2,0,0"
                    Foreground="Orange"
                    Text="{Binding Warnings}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl Margin="0,2,0,0" ItemsSource="{Binding PickList}" />
            </StackPanel>
        </Border>

        <TextBlock
            Margin="8,4"
            DockPanel.Dock="Bottom"
            FontFamily="Consolas"
            Text="{Binding CursorText}" />

        <Grid
            x:Name="Viewport"
            Background="Black"
            ClipToBounds="True"
            MouseLeftButtonDown="OnMouseDown"
            MouseLeftButtonUp="OnMouseUp"
            MouseMove="OnMouseMove"
            MouseWheel="OnMouseWheel">
            <Image
                x:Name="Picture"
                RenderOptions.BitmapScalingMode="HighQuality"
                RenderTransformOrigin="0,0"
                Source="{Binding Image}"
                Stretch="Uniform">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="Pan" X="0" Y="0" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
        </Grid>
    </DockPanel>
</Window>
