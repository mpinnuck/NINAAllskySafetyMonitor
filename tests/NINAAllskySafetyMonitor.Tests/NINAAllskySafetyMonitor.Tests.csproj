<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests for Core (one test class per Core class) and requirement-coverage tests. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>NINAAllskySafetyMonitor.Tests</RootNamespace>
    <AssemblyName>NINAAllskySafetyMonitor.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NINAAllskySafetyMonitor.Core\NINAAllskySafetyMonitor.Core.csproj" />
    <!-- The offline replay harness (cross-platform). -->
    <ProjectReference Include="..\..\tools\NINAAllskySafetyMonitor.Harness\NINAAllskySafetyMonitor.Harness.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sample frames and weather JSON copied next to the test assembly. -->
    <None Include="TestData\**\*" Exclude="TestData\**\.gitkeep" CopyToOutputDirectory="PreserveNewest" />
    <!-- requirements.md, read by the coverage tests. -->
    <None Include="..\..\docs\requirements\requirements.md" Link="TestData\requirements.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
