<Project>
  <!-- Settings shared by every project in the solution. -->
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <Deterministic>true</Deterministic>

    <Company>Mark Pinnuck</Company>
    <Product>NINAAllskySafetyMonitor</Product>
    <Copyright>Copyright © 2026 Mark Pinnuck</Copyright>

    <!-- Plugin release version. Keep in step with Properties/AssemblyInfo.cs in the Plugin project. -->
    <VersionPrefix>1.0.0</VersionPrefix>

    <!-- Stable compile-time API baseline for NINA 3.2 and later. -->
    <NinaPluginVersion>3.2.0.9001</NinaPluginVersion>

    <!-- AstroPC's installed NINA 3.3 nightly folder; independent of the stable 3.2 compile-time API baseline. -->
    <NinaPluginFolder>3.3.0</NinaPluginFolder>
  </PropertyGroup>
</Project>
