<Project>
  <!-- Settings shared by every project in the solution. -->
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>

    <Company>Mark Pinnuck</Company>
    <Product>NINAAllskySafetyMonitor</Product>
    <Copyright>Copyright © 2026 Mark Pinnuck</Copyright>

    <!-- Plugin release version. Keep in step with Properties/AssemblyInfo.cs in the Plugin project. -->
    <VersionPrefix>1.0.0</VersionPrefix>

    <!--
      NINA.Plugin NuGet package version.
      Placeholder from the official NINA plugin template. Set this to the version used by
      RATrendCompensatorNINA (proven against NINA 3.3.0.1057 nightly), or update it with the
      NuGet package manager in Visual Studio on the AstroPC.
    -->
    <NinaPluginVersion>3.0.0.2017-beta</NinaPluginVersion>

    <!-- NINA's per-version plugin folder used by the Plugin project's post-build copy. -->
    <NinaPluginFolder>3.0.0</NinaPluginFolder>
  </PropertyGroup>
</Project>
