@startuml CL11_HarnessTests
!include _style.iuml
title CL-11  NINAAllskySafetyMonitor.Harness and NINAAllskySafetyMonitor.Tests

package "NINAAllskySafetyMonitor.Harness" {
  class Program {
    +Main(args) : int
  }
  class ReplayCommand {
    +FramesFolder : string
    +SettingsFile : string
    +OutputCsv : string
    +RunAsync() : Task<int>
    .. REQ-42 ..
  }
  class FixedMountStateSource {
    +GetCurrent() : MountState?
    .. REQ-42 ..
  }
  class ConfigSiteLocationSource {
    +GetCurrent() : SiteLocation?
  }
  class ReplayClock {
    +UtcNow : DateTime
    .. REQ-42 ..
  }
  class ConsoleLogSink {
    +Write(level, message)
  }
  class TraceabilityReportCommand {
    +RequirementsFile : string
    +OutputXlsx : string
    +Run() : int
  }
}

package "NINAAllskySafetyMonitor.Tests" {
  package "Traceability" as TT {
    class RequirementCoverageTests {
      +RequirementsFileHasRequirements()
      +NoUnknownRequirementIds()
      +EveryRequirementHasImplementation()
      +EveryRequirementHasTest()
      +CoverageReport()
    }
    class RequirementsParser <<static>> {
      +Parse(markdownPath) : IReadOnlyList<RequirementInfo>
    }
    class RequirementTagScanner <<static>> {
      +Scan(folder) : map REQ → files
    }
    class RequirementInfo <<record>> {
      +Id : string
      +Text : string
    }
    class RepositoryPaths <<static>> {
      +Root : string
      +RequirementsFile : string
    }
  }
  package "Fakes" as TF {
    class FakeClock
    class FakeAstroCalculator
    class FakeSiteLocationSource
    class ListLogSink
    class DelegateCycle
  }
  class UnitTestFixtures <<namespace>> {
    one test class per Core class, in a folder
    matching the Core package, tagged [Requirement("REQ-xx")]
  }
}

Program ..> ReplayCommand
Program ..> TraceabilityReportCommand
ReplayCommand ..> FixedMountStateSource
ReplayCommand ..> ConfigSiteLocationSource
ReplayCommand ..> ReplayClock
ReplayCommand ..> ConsoleLogSink
ReplayCommand ..> "ReplayImageSource"
ReplayCommand ..> "MonitorServiceBuilder"
TraceabilityReportCommand ..> RequirementsParser
RequirementCoverageTests ..> RequirementsParser
RequirementCoverageTests ..> RequirementTagScanner
RequirementCoverageTests ..> RepositoryPaths
RequirementsParser ..> RequirementInfo
UnitTestFixtures ..> TF

note bottom of RequirementTagScanner
  Scans source files for [Requirement(...)] rather
  than reflecting over assemblies, so it also covers
  the Windows-only Plugin and Astrometry projects
  when the tests run on the Mac.
end note

note bottom of ReplayClock
  Clock set from each frame's capture time,
  so the operating window, Moon and ROI are
  evaluated as they were on the night.
end note
@enduml
