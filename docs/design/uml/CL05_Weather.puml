@startuml CL05_Weather
!include _style.iuml
title CL-05  Core.Weather

package "NINAAllskySafetyMonitor.Core.Weather" {
  interface IWeatherProvider {
    +GetLatestAsync(ct) : Task<WeatherFetchResult>
    .. REQ-32 ..
  }
  class WeatherFetchResult <<record>> {
    +Observation : WeatherObservation?
    +Error : string?
  }
  class PwsWeatherClient {
    -http : HttpClient
    -parser : PwsObservationParser
    +GetLatestAsync(ct)
    ~{static} RequestUrl(settings) : Uri
    ~{static} Redact(text, settings) : string
    .. REQ-32 REQ-51 REQ-54 ..
  }
  class PwsObservationParser {
    +Parse(json) : WeatherObservation
    .. REQ-33 ..
  }
  class WeatherPoller {
    -lastPollUtc : DateTime?
    +Latest : WeatherObservation?
    +LastError : string?
    +PollIfDueAsync(ct) : Task
    .. REQ-32 ..
  }
  class WeatherEvaluator {
    +Evaluate(obs, lastError, nowUtc, settings) : IReadOnlyList<ConditionCheck>
    .. REQ-34 REQ-35 REQ-36 REQ-50 ..
  }
  class WeatherFetchTester {
    +TestAsync(settings, ct) : Task<string>
    .. REQ-46 ..
  }
}

IWeatherProvider <|.. PwsWeatherClient
IWeatherProvider ..> WeatherFetchResult
PwsWeatherClient --> PwsObservationParser
WeatherPoller --> IWeatherProvider
WeatherFetchTester ..> PwsWeatherClient

note bottom of WeatherEvaluator
  NoRain: precipRate > 0 fails. WindBelowLimit: gust > MaxGustKmH fails.
  WeatherCurrent: no data, or older than StaleAfterMin, fails.
  No data: all three fail with one reason. Weather off: all three pass.
  No data or old data is undetermined (may be assumed safe, REQ-50);
  reported rain or gust is not.
end note
note bottom of PwsWeatherClient
  GET api.weather.com/v2/pws/observations/current
  ?stationId&format=json&units=m&apiKey.
  Messages name the station, never the key.
end note
@enduml
