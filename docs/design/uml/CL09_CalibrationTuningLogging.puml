    +FromSkyImage(image : SkyImage) : DateTime
    .. REQ-20 ..
  }
  class InitialGuessSearch {
    -catalogue : StarCatalogue
    +Search(detected, frame, site, utc) : LensCalibration?
    .. REQ-20 ..
  }
  class StarIdentification <<record>> {
    +Star : CatalogueStar
    +Position : PixelPoint
  }
  class SkyStar <<record>> {
    +Star : CatalogueStar
    +Position : HorizontalCoordinate
  }
  class SkyStars <<static>> {
    +AboveHorizon(stars, site, utc, minAltDeg) : IReadOnlyList<SkyStar>
    .. REQ-20 REQ-24 ..
  }
  class SpotIndex <<internal>> {
    +Nearest(x, y, radius) : int
  }
  class StarMatch <<record>> {
    +Star : SkyStar
    +Detected, Predicted : PixelPoint
    +ErrorPx, ErrorDeg : double
  }
  class LevenbergMarquardt <<static>> {
    +Minimise(residuals, start, free) : double[]
  }
  class LensFitter {
    -catalogue : StarCatalogue
    +Fit(detected, start : LensCalibration, site, utc) : LensFitResult
    .. REQ-19 REQ-20 ..
  }
  class LensFitResult <<record>> {
    +Lens : LensCalibration
    +Matches : IReadOnlyList<StarMatch>
    +StarsMatched : int
    +RmsErrorPx : double
    +RmsErrorDeg : double
  }
  class CalibrationQualityCheck {
    -settings : Func<LensFitSettings>
    +Warnings(result : LensFitResult) : IReadOnlyList<string>
    .. REQ-20 ..
  }
  class LensCalibrationSession {
    -detector : StarDetector
    -search : InitialGuessSearch
    -fitter : LensFitter
    -quality : CalibrationQualityCheck
