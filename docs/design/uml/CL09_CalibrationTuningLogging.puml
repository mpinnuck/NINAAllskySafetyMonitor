@startuml CL09_CalibrationTuningLogging
!include _style.iuml
left to right direction
title CL-09  Core.Calibration, Core.Tuning, Core.Logging, Core.Traceability

package "NINAAllskySafetyMonitor.Core.Calibration" {
  class StarIdentifier {
    -catalogue : StarCatalogue
    +Identify(detected, site, utc, approx : LensCalibration?) : IReadOnlyList<(CatalogueStar, DetectedStar)>
    .. REQ-20 ..
  }
  class LensModelFitter {
    +Fit(pairs, site, utc) : LensFitResult
    .. REQ-19 REQ-20 ..
  }
  class LensFitResult <<record>> {
    +Calibration : LensCalibration
    +RmsErrorPx : double
    +StarsUsed : int
  }
  class CalibrationOverlayRenderer {
    +Render(frame, projection, site, utc) : OverlayImage
    .. REQ-21 ..
  }
  class LensCalibrationSession {
    -detector : StarDetector
    -identifier : StarIdentifier
    -fitter : LensModelFitter
    +CalibrateAsync(image : SkyImage, site) : Task<LensFitResult>
    .. REQ-19 REQ-20 ..
  }
}

package "NINAAllskySafetyMonitor.Core.Tuning" {
  class TuningRecorder {
    -folder : string
    -csv : MetricsCsvWriter
    +Record(s : MonitorSnapshot)
    .. REQ-41 ..
  }
  class MetricsCsvWriter {
    +Append(s : MonitorSnapshot)
    .. REQ-41 ..
  }
  class ReplayImageSource {
    -frames : IEnumerator<string>
    +Kind = Replay
    +FetchAsync(ct) : Task<FetchResult>
    .. REQ-42 ..
  }
  class TuningStateEvaluator {
    -cloud : CloudDetectionSettings
    +IsUntuned : bool
    .. REQ-43 ..
  }
}

package "NINAAllskySafetyMonitor.Core.Logging" {
  class DecisionLogger {
    -settings : Func<LoggingSettings>
    -redactor : SecretRedactor
    +Write(s : MonitorSnapshot)
    +{static} FileName(localDate) : string
    .. REQ-06 REQ-44 REQ-54 ..
  }
  class SecretRedactor {
    -secrets : Func<IEnumerable<string?>>
    +Redact(text : string) : string
    .. REQ-54 ..
  }
  class RedactingLogSink {
    -inner : ILogSink
    +Write(level, message)
    .. REQ-54 ..
  }
}

package "NINAAllskySafetyMonitor.Core.Traceability" {
  class RequirementAttribute <<Attribute>> {
    +Ids : string[]
    +RequirementAttribute(params string[] ids)
  }
}

interface IImageSource
interface ILogSink
IImageSource <|.. ReplayImageSource
ILogSink <|.. RedactingLogSink
LensCalibrationSession --> StarIdentifier
LensCalibrationSession --> LensModelFitter
LensModelFitter ..> LensFitResult
TuningRecorder --> MetricsCsvWriter
RedactingLogSink --> SecretRedactor
DecisionLogger --> SecretRedactor
note bottom of DecisionLogger
  decisions-yyyy-MM-dd.csv per local day (Excel): time, event
  (Start / State change), state, safe, override, countdown, reason,
  image and weather metrics; mount Alt/Az for diagnostics (REQ-06).
  Files older than RetentionDays [7] are deleted (and the deletion logged).
end note

note bottom of RequirementAttribute
  Applied to every class (and to methods where a class
  covers several requirements), and to every test.
  A coverage test fails the build if any REQ has
  no implementing class or no test.
end note
@enduml
