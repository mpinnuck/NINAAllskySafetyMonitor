@startuml CL08_DecisionMonitoring
!include _style.iuml
title CL-08  Core.Decision and Core.Monitoring

package "NINAAllskySafetyMonitor.Core.Decision" {
  class SafetyHysteresis {
    -clearSinceUtc : DateTime?
    +Apply(allPassed, nowUtc, safeAfter) : (bool Safe, int? SecondsToSafe)
    +Reset()
    .. REQ-38 REQ-39 ..
  }
  class SlewHoldPolicy {
    +ShouldHold(m : MountState?) : bool
    .. REQ-27 ..
  }
  class ManualOverride {
    +Mode : OverrideMode
    +event Changed
    +Apply(s : SafetyStatus) : SafetyStatus
    .. REQ-40 ..
  }
  class SafetyDecisionEngine {
    -hysteresis : SafetyHysteresis
    -clock : IClock
    -safeAfter : Func<TimeSpan>
    -slewHold : SlewHoldPolicy
    -lastDecided : SafetyStatus?
    +Decide(snapshot : MonitorSnapshot) : SafetyStatus
    .. REQ-03 REQ-27 REQ-37 REQ-38 REQ-39 ..
  }
}

package "NINAAllskySafetyMonitor.Core.Monitoring" {
  interface IMonitoringCycle {
    +RunOnceAsync(ct) : Task<MonitorSnapshot>
  }
  class MonitorService {
    -cycle : IMonitoringCycle
    -guard : FailSafeGuard
    -engine : SafetyDecisionEngine?
    -manualOverride : ManualOverride?
    -interval : Func<TimeSpan>
    -mountWatcher : MountWatcher?
    -wake : SemaphoreSlim
    +CurrentStatus : SafetyStatus
    +IsRunning : bool
    +Start()
    +StopAsync() : Task
    +RequestEvaluation()
    +event SnapshotAvailable
    ~{static} ReasonKind(reason) : string
    .. REQ-02 REQ-27 REQ-38 REQ-40 REQ-49 ..
  }
  class MountWatcher {
    -source : IMountStateSource
    -pollInterval : Func<TimeSpan>
    +MoveThresholdDeg = 0.5
    +Poll() : bool
    +Start()
    +StopAsync() : Task
    +event Changed
    ~{static} Significant(a, b : MountState?) : bool
    .. REQ-05 REQ-27 ..
  }
  class MonitoringCycle {
    -settings : Func<MonitorSettings>
    -siteResolver : SiteLocationResolver
    -window : OperatingWindow
    -acquirer : ImageAcquirer
    -freshness : ImageFreshnessEvaluator
    -weather : WeatherPoller
    -weatherEvaluator : WeatherEvaluator
    -mount : IMountStateSource
    -roiCalculator : RoiCalculator
    -roiBuilder : RoiBuilder
    -cloudDetector : CloudDetector
    -recorder : TuningRecorder
    -lastImageFetchUtc : DateTime?
    +RunOnceAsync(ct) : Task<MonitorSnapshot>
    .. REQ-05 REQ-10 REQ-14 REQ-37 ..
  }
  class FailSafeGuard {
    -timeout : Func<TimeSpan>
    +RunAsync(cycle : IMonitoringCycle, ct) : Task<MonitorSnapshot>
    .. REQ-49 REQ-50 REQ-51 ..
  }
  class StatusHistory {
    -points : RingBuffer<MonitorSnapshot>
    +Add(s : MonitorSnapshot)
    +ForNight(nowUtc) : IReadOnlyList<MonitorSnapshot>
    .. REQ-45 ..
  }
  class MonitorServiceBuilder {
    +Build(settings, ports, manualOverride?) : MonitorService
    +Build(settings, ports, sources, weatherProvider, manualOverride?) : MonitorService
  }
  class MonitorPorts <<record>> {
    +Clock : IClock
    +Site : ISiteLocationSource
    +Astro : IAstroCalculator
    +Log : ILogSink
    +Credentials : ICredentialStore
    +Mount : IMountStateSource?
  }
}

SafetyDecisionEngine --> SafetyHysteresis
SafetyDecisionEngine --> SlewHoldPolicy
MonitorService --> IMonitoringCycle
MonitorService --> FailSafeGuard
MonitorService --> SafetyDecisionEngine
MonitorService --> ManualOverride
MonitorService --> MountWatcher : Changed → RequestEvaluation
IMonitoringCycle <|.. MonitoringCycle
MonitorServiceBuilder ..> MonitorService : creates
MonitorServiceBuilder ..> MonitorPorts
MonitorServiceBuilder ..> "DecisionLogger" : subscribes to SnapshotAvailable

note bottom of MonitoringCycle
  Reads settings at the start of every cycle. Outside the
  window: Idle, nothing fetched. Inside: image (at most once per
  image interval) and weather fetched in parallel; ROI placed
  from the mount; conditions gathered; the provisional reason
  lists every failed condition.
end note
note bottom of MonitorService
  Each snapshot: FailSafeGuard → engine.Decide → override.Apply
  → publish. CurrentStatus applies the override live, so
  a change takes effect at once. State changes are logged.
  Waits for the image interval, or less when MountWatcher
  reports a change (every 2 s: slew start or end, park,
  tracking, a move > 0.5° outside a slew), so a slew is
  held within seconds (REQ-27).
end note
note right of FailSafeGuard
  Timeout + catch-all: any exception or
  timeout gives an Unsafe snapshot with no
  conditions, which also restarts the
  safe-after period (REQ-49, REQ-50).
end note
@enduml
