@startuml SD02_MonitoringCycle
!include _style.iuml
title SD-02  Monitoring cycle — normal path (UC-04 … UC-10, UC-18)

participant ":MonitorService" as Svc
participant ":FailSafeGuard" as Guard
participant ":MonitoringCycle" as Cyc
participant ":SiteLocationResolver" as Site
participant ":OperatingWindow" as Win
participant ":ImageAcquirer" as Acq
participant ":WeatherPoller" as WP
participant ":ImageFreshnessEvaluator" as Fresh
participant ":WeatherEvaluator" as WE
participant ":IMountStateSource" as Mount
participant ":RoiCalculator" as Roi
participant ":RoiBuilder" as RB
participant ":CloudDetector" as Cloud
participant ":SafetyDecisionEngine" as Eng
participant ":ManualOverride" as Ovr
participant ":DecisionLogger" as Log

loop every IntervalS [60 s]
  Svc -> Guard : RunAsync(cycle, ct)
  activate Guard
  Guard -> Cyc : RunOnceAsync(ct)  [timeout]
  activate Cyc
  Cyc -> Cyc : s = settings()  (read every cycle)
  Cyc -> Site : Resolve()
  Site --> Cyc : site  (profile, else config — REQ-04)
  Cyc -> Win : Evaluate(site, now, limit)
  Win --> Cyc : ActiveWindow passed  (REQ-08, REQ-09)
  par image and weather
    Cyc -> Acq : AcquireAsync(ct)  (see SD-06)
  else
    Cyc -> WP : PollIfDueAsync(ct)  (every 2 min, REQ-32, REQ-33)
  end
  Cyc -> Fresh : Evaluate(latest, lastSuccess, lastError, now)
  Fresh --> Cyc : FreshImage  (REQ-15, REQ-18)
  Cyc -> WE : Evaluate(WP.Latest, WP.LastError, now)
  WE --> Cyc : NoRain, WindBelowLimit, WeatherCurrent  (REQ-34, REQ-35, REQ-36)
  Cyc -> Mount : GetCurrent()
  Mount --> Cyc : MountState
  Cyc -> Roi : CalculateCentre(mount, site, now)
  Roi --> Cyc : centre from RA/Dec, or null  (REQ-06, REQ-24, REQ-26)
  Cyc -> RB : Build(centre, 15°, 0.5, w, h)
  RB --> Cyc : RegionOfInterest: circle within the working area,\nor whole working area  (REQ-23, REQ-25, REQ-58)
  Cyc -> Cloud : Assess(frame, roi, site, now, ref)
  Cloud --> Cyc : NoCloud  (see SD-03)
  Cyc -> Cyc : provisional reason = every failed condition
  opt tuning mode on
    Cyc -> Cyc : recorder.Record(snapshot)  (REQ-41)
  end
  Cyc --> Guard : MonitorSnapshot
  deactivate Cyc
  Guard --> Svc : MonitorSnapshot
  deactivate Guard
  Svc -> Eng : Decide(snapshot)  (see SD-04)
  Eng --> Svc : decided status
  Svc -> Ovr : Apply(decided)  (REQ-40)
  Ovr --> Svc : reported status
  Svc -> Svc : log state change; raise SnapshotAvailable
  Svc -> Log : Write(snapshot)  [subscriber]  (REQ-44, REQ-54)
end
@enduml
