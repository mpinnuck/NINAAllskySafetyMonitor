@startuml CL07_Analysis
!include _style.iuml
left to right direction
title CL-07  Core.Analysis — sky-frame check and cloud detection

package "NINAAllskySafetyMonitor.Core.Analysis" {
  class StarCatalogue {
    -stars : IReadOnlyList<CatalogueStar>
    +{static} LoadEmbedded() : StarCatalogue
    +BrighterThan(limitMag : double) : IEnumerable<CatalogueStar>
    +Named() : IEnumerable<CatalogueStar>
    .. REQ-20 REQ-29 ..
  }
  class StarDetector {
    +Detect(frame : GrayFrame, mask : PixelMask?, bounds : PixelRect?) : IReadOnlyList<DetectedStar>
    .. REQ-20 REQ-29 ..
  }
  class SkyFrameCheck {
    +Evaluate(frame : GrayFrame, area : WorkingArea, lens : LensCalibration) : ConditionCheck
    .. REQ-60 ..
  }
  class RoiMaskBuilder {
    -areaKey, areaMask  (last working-area mask)
    +BuildArea(area : WorkingArea, projection, width, height) : PixelMask
    +Build(roi : RegionOfInterest, area : WorkingArea, projection, width, height) : PixelMask
    .. REQ-25 REQ-29 ..
  }
  class ExpectedStar <<record>> {
    +Star : CatalogueStar
    +Sky : HorizontalCoordinate
    +Position : PixelPoint
  }
  class ExpectedStarPredictor {
    -catalogue : StarCatalogue
    +Predict(roiMask, projection, site, nowUtc, limitMag, moon : MoonState?, moonExclusionDeg) : IReadOnlyList<ExpectedStar>
    .. REQ-29 REQ-31 ..
  }
  class StarMatcher {
    +Match(expected, detected, tolerancePx) : IReadOnlyList<DetectedStar?>
    .. REQ-29 ..
  }
  class StarFractionTest {
    -settings : Func<CloudDetectionSettings>
    +Evaluate(expectedCount, matchedCount) : StarTestResult
    .. REQ-29 ..
  }
  class BlockStatistics <<record>> {
    +BlockSize : int
    +FrameWidth, FrameHeight : int
    +Median : float[]  (NaN = not measured)
    +Uniformity : float[]
    +Columns, Rows : int
    +IsValid(i) : bool
    +SameGridAs(other) : bool
  }
  class BackgroundStatistics {
    +Measure(frame : GrayFrame, areaMask : PixelMask) : BlockStatistics
    .. REQ-30 ..
  }
  class ClearSkyReference <<record>> {
    +Blocks : BlockStatistics
    +CapturedUtc : DateTime
    .. REQ-30 REQ-57 ..
  }
  class ClearSkyReferenceBuilder {
    +CanCapture(tuned, moonAltDeg) : bool
    +TryCapture(blocks, wholeAreaStarTest, moonAltDeg, tuned, utc) : ClearSkyReference?
    .. REQ-30 ..
  }
  class MoonBrightnessAdjuster {
    +Factor(moonAltDeg, illumination) : double
    .. REQ-31 ..
  }
  class BrightnessTest {
    -settings : Func<CloudDetectionSettings>
    +Evaluate(current : BlockStatistics, reference : ClearSkyReference?, roiMask, moonFactor) : BrightnessTestResult
    .. REQ-30 REQ-31 ..
  }
  class StarTestResult <<record>> {
    +Expected : int
    +Matched : int
    +Fraction : double?
    +Inconclusive : bool
    +Cloud : bool
  }
  class BrightnessTestResult <<record>> {
    +RelativeBrightness : double?
    +UniformityRatio : double?
    +Skipped : bool
    +Cloud : bool
  }
  class CloudDetector {
    -predictor, detector, matcher
    -starTest, background, brightnessTest
    -moonAdjuster, referenceBuilder
    +Assess(frame, roi, workingArea, lens, site, nowUtc, moon, reference) : CloudDetection
    +{static} MatchTolerancePx(lens, width) : double
    -lastBlocks : (GrayFrame, area key) → BlockStatistics
    .. REQ-28 ..
  }
  class CloudDetection <<record>> {
    +Assessment : CloudAssessment
    +CapturedReference : ClearSkyReference?
    .. REQ-28 REQ-30 ..
  }
  class CompactFloatArrayConverter {
    JSON: one string of numbers per array
  }
}

ExpectedStarPredictor --> StarCatalogue
ExpectedStarPredictor ..> ExpectedStar
StarMatcher ..> ExpectedStar
StarFractionTest ..> StarTestResult
BackgroundStatistics ..> BlockStatistics
ClearSkyReference *-- BlockStatistics
ClearSkyReferenceBuilder ..> ClearSkyReference
BrightnessTest ..> BrightnessTestResult
BrightnessTest ..> ClearSkyReference
CloudDetector --> RoiMaskBuilder
CloudDetector --> ExpectedStarPredictor
CloudDetector --> StarDetector
CloudDetector --> StarMatcher
CloudDetector --> StarFractionTest
CloudDetector --> BackgroundStatistics
CloudDetector --> BrightnessTest
CloudDetector --> MoonBrightnessAdjuster
CloudDetector --> ClearSkyReferenceBuilder
CloudDetector ..> CloudDetection
CloudDetection o-- ClearSkyReference
BlockStatistics ..> CompactFloatArrayConverter

note bottom of StarCatalogue
  Embedded resource Resources/BrightStars.csv in the Core DLL:
  Yale Bright Star Catalogue (5th ed., public domain), stars
  brighter than mag 4.5 (904), J2000, names for the brightest.
end note
note bottom of SkyFrameCheck
  Returns a failed NoCloud check, "Not a sky frame (Allsky
  notice image?)", so REQ-37's conditions are unchanged.
  Not a sky frame (REQ-60) when the size differs from the
  calibrated frame, or inside the working area the pixel-to-pixel
  noise is below 0.5 grey levels and over half the pixels are
  within ±1 of one value (Allsky's notice images are drawn,
  so flat; real frames always have sensor noise, ~1.1 here).
end note
note bottom of ExpectedStarPredictor
  Catalogue stars to the limiting magnitude [4.4] inside the
  ROI circle AND the working area (circle and outline), more
  than [15°] from the Moon; stars behind trees are never
  expected. Test frame: clear ROIs see 100% of them.
end note
note bottom of BackgroundStatistics
  32 px blocks with ≥ half their pixels in the working area:
  median, and non-uniformity = (P84 − P16) ÷ 2 ÷ median.
  Percentiles ignore the few star and hot pixels.
end note
note bottom of BrightnessTest
  Exposure-independent (Allsky auto-exposure keeps overall
  brightness steady). Per block: k = current median ÷ reference
  median. Relative brightness = median k in the ROI ÷ median k
  over the whole working area; above [1.3×] → cloud.
  Non-uniformity ratio = ROI uniformity ÷ reference uniformity
  (scale-free); above [1.5×] → cloud. Both limits raised by the
  Moon factor 1 + 0.5 × illumination × sin(alt). No reference,
  another image size, or < 3 ROI blocks → skipped.
end note
note bottom of CloudDetector
  Not a sky frame → no cloud assessment (SkyFrameCheck fails).
  Cloud = star test says cloud OR brightness test says cloud.
  Star test inconclusive (< 8 expected) → brightness test alone.
  No clear-sky reference yet → star test alone.
  Both unavailable → cloud assumed (fail-safe, REQ-50).
  Reference capture: no reference, tuned, Moon down, ROI not
  cloudy → star test over the whole working area; ≥ 0.9 found →
  CapturedReference (saved by the host, REQ-57).
  The block map of the last frame is kept, so several ROIs on one
  frame (harness targets, mount re-checks) measure it once.
end note
@enduml
