@startuml CL07_Analysis
!include _style.iuml
left to right direction
title CL-07  Core.Analysis — cloud detection

package "NINAAllskySafetyMonitor.Core.Analysis" {
  class StarCatalogue {
    -stars : IReadOnlyList<CatalogueStar>
    +{static} LoadEmbedded() : StarCatalogue
    +BrighterThan(limitMag : double) : IEnumerable<CatalogueStar>
    +Named() : IEnumerable<CatalogueStar>
    .. REQ-20 REQ-29 ..
  }
  class GrayFrameDecoder {
    +Decode(jpeg : byte[]) : GrayFrame
  }
  class ExpectedStar <<record>> {
    +Star : CatalogueStar
    +Position : PixelPoint
  }
  class ExpectedStarPredictor {
    -catalogue : StarCatalogue
    -astro : IAstroCalculator
    -projection : LensProjection
    +Predict(roi, site, nowUtc, limitMag, moonExclusionDeg) : IReadOnlyList<ExpectedStar>
    .. REQ-29 REQ-31 ..
  }
  class StarDetector {
    +Detect(frame : GrayFrame, mask : PixelMask?) : IReadOnlyList<DetectedStar>
    .. REQ-20 REQ-29 ..
  }
  class StarMatcher {
    -tolerancePx : double
    +Match(expected, detected) : IReadOnlyList<(ExpectedStar, DetectedStar)>
  }
  class StarFractionTest {
    -minFraction : double
    -minExpected : int
    +Evaluate(expectedCount, matchedCount) : StarTestResult
    .. REQ-29 ..
  }
  class BackgroundStatistics {
    +Measure(frame, mask, starsToExclude) : (double median, double uniformity)
  }
  class MoonBrightnessAdjuster {
    -astro : IAstroCalculator
    +Factor(site, nowUtc) : double
    .. REQ-31 ..
  }
  class BrightnessTest {
    -maxBrightnessRatio : double
    -maxUniformityRatio : double
    +Evaluate(median, uniformity, reference : ClearSkyReference?, moonFactor) : BrightnessTestResult
    .. REQ-30 ..
  }
  class ClearSkyReference <<record>> {
    +Median : double
    +Uniformity : double
    +CapturedUtc : DateTime
    .. REQ-30 REQ-57 ..
  }
  class ClearSkyReferenceBuilder {
    +TryCapture(snapshot : MonitorSnapshot, tuned : bool) : ClearSkyReference?
    .. REQ-30 ..
  }
  class StarTestResult <<record>> {
    +Fraction : double?
    +Inconclusive : bool
    +Cloud : bool
  }
  class BrightnessTestResult <<record>> {
    +BrightnessRatio : double?
    +UniformityRatio : double?
    +Skipped : bool
    +Cloud : bool
  }
  class CloudDetector {
    -predictor : ExpectedStarPredictor
    -detector : StarDetector
    -matcher : StarMatcher
    -starTest : StarFractionTest
    -background : BackgroundStatistics
    -brightnessTest : BrightnessTest
    -moonAdjuster : MoonBrightnessAdjuster
    +Assess(frame, roi, site, nowUtc, reference) : CloudAssessment
    .. REQ-28 ..
  }
}

ExpectedStarPredictor --> StarCatalogue
ExpectedStarPredictor ..> ExpectedStar
StarMatcher ..> ExpectedStar
StarFractionTest ..> StarTestResult
BrightnessTest ..> BrightnessTestResult
BrightnessTest ..> ClearSkyReference
ClearSkyReferenceBuilder ..> ClearSkyReference
CloudDetector --> ExpectedStarPredictor
CloudDetector --> StarDetector
CloudDetector --> StarMatcher
CloudDetector --> StarFractionTest
CloudDetector --> BackgroundStatistics
CloudDetector --> BrightnessTest
CloudDetector --> MoonBrightnessAdjuster

note bottom of StarCatalogue
  Embedded resource Resources/BrightStars.csv in the Core DLL:
  Yale Bright Star Catalogue (5th ed., public domain), stars
  brighter than mag 4.5 (about 900), J2000, with names for the
  brightest (for star identification). Shared by calibration
  (5b) and cloud detection (6).
end note
note bottom of StarDetector
  3×3 median removes single hot pixels; background
  subtracted; spots of 2–80 px above k·noise, roughly
  round; centroid and flux. Unmatched spots (noise, tree
  gaps) are ignored by matching.
end note
note bottom of CloudDetector
  Cloud = star test says cloud OR brightness test says cloud.
  Star test inconclusive (< 8 expected) -> brightness test alone.
  No clear-sky reference yet -> star test alone.
  Both unavailable -> cloud assumed (fail-safe, REQ-50).
end note
@enduml
