@startuml SD03_CloudDetection
!include _style.iuml
title SD-03  Detect cloud in ROI (UC-08) — REQ-28 … REQ-31

participant ":MonitoringCycle" as Cyc
participant ":CloudDetector" as CD
participant ":ExpectedStarPredictor" as Pred
participant ":IAstroCalculator" as Astro
participant ":LensProjection" as Proj
participant ":StarDetector" as Det
participant ":StarMatcher" as Match
participant ":StarFractionTest" as ST
participant ":BackgroundStatistics" as BG
participant ":MoonBrightnessAdjuster" as Moon
participant ":BrightnessTest" as BT

Cyc -> CD : Assess(frame, roi, site, now, reference)
activate CD
CD -> Pred : Predict(roi, site, now, mag 4.0, moon 15°)
loop catalogue stars brighter than limit
  Pred -> Astro : ToHorizontal(ra, dec, J2000, site, now)
  Pred -> Proj : ToPixel(altaz)
  Pred -> Pred : keep if inside ROI mask\nand > 15° from Moon (REQ-31)
end
Pred --> CD : expected stars
CD -> Det : Detect(frame, roi.Mask)
Det --> CD : detected stars
CD -> Match : Match(expected, detected)
Match --> CD : matched pairs
CD -> ST : Evaluate(expected.Count, matched.Count)
alt expected < 8
  ST --> CD : Inconclusive
else fraction < 0.70
  ST --> CD : Cloud
else
  ST --> CD : Clear
end
CD -> BG : Measure(frame, roi.Mask, detected)
BG --> CD : median, uniformity
CD -> Moon : Factor(site, now)
Moon --> CD : moon factor
CD -> BT : Evaluate(median, uniformity, reference, factor)
alt no clear-sky reference yet
  BT --> CD : Skipped
else median > 1.3×ref  or  uniformity > 1.5×ref
  BT --> CD : Cloud
else
  BT --> CD : Clear
end
CD -> CD : cloud = starCloud OR brightnessCloud\n(both unavailable → cloud, fail-safe)
CD --> Cyc : CloudAssessment
deactivate CD
@enduml
