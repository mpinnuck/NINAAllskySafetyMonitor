@startuml SD03_CloudDetection
!include _style.iuml
title SD-03  Check the frame and detect cloud in the ROI (UC-08) — REQ-28 … REQ-31, REQ-60

participant ":MonitoringCycle" as Cyc
participant ":IFrameDecoder" as Dec
participant ":SkyFrameCheck" as SF
participant ":CloudDetector" as CD
participant ":RoiMaskBuilder" as Mask
participant ":ExpectedStarPredictor" as Pred
participant ":StarDetector" as Det
participant ":StarMatcher" as Match
participant ":StarFractionTest" as ST
participant ":BackgroundStatistics" as BG
participant ":BrightnessTest" as BT
participant ":ClearSkyReferenceBuilder" as Ref
participant "ReferenceCaptured\n(host)" as Host

alt no decoder, no image or no lens
  Cyc -> Cyc : NoCloud failed with the reason
end
Cyc -> Dec : Decode(jpeg)  (new image only; same image reuses the frame)
Dec --> Cyc : GrayFrame (darkest channel)
Cyc -> SF : Evaluate(frame, area, lens)
alt not a sky frame (wrong size, or flat background)
  SF --> Cyc : NoCloud failed: "Not a sky frame (Allsky notice image?)"  REQ-60
  note right of Cyc : No cloud assessment this cycle; unsafe.
else sky frame
  Cyc -> CD : Assess(frame, roi, workingArea, lens, site, now, moon, reference)
  activate CD
  CD -> Mask : BuildArea(area, projection), Build(roi, …)
  Mask --> CD : working-area pixels (kept until lens/area/size change);\nROI pixels (circle ∩ working area ∩ outline)
  CD -> Pred : Predict(ROI mask, …, mag 4.4, moon, 15°)
  Pred --> CD : expected stars (inside ROI and working area, away from the Moon)
  CD -> Det : Detect(frame, ROI mask, ROI bounds)
  Det --> CD : detected stars
  CD -> Match : Match(expected, detected, max(3 × fit RMS, 4 px))
  Match --> CD : matched
  CD -> ST : Evaluate(expected, matched)
  alt expected < 8
    ST --> CD : Inconclusive
  else fraction < 0.70
    ST --> CD : Cloud  "Cloud: 3 of 11 stars"
  else
    ST --> CD : Clear
  end
  CD -> BG : Measure(frame, working-area mask)
  BG --> CD : block medians and non-uniformity
  CD -> BT : Evaluate(blocks, reference, ROI mask, moon factor)
  alt no reference yet
    BT --> CD : Skipped
  else ROI relative brightness > 1.3  or  non-uniformity ratio > 1.5
    BT --> CD : Cloud
  else
    BT --> CD : Clear
  end
  opt no reference yet, tuned, Moon down, ROI not cloudy
    CD -> Pred : Predict(working-area mask, …)
    CD -> Det : Detect(frame, working-area mask)
    CD -> ST : Evaluate (whole working area)
    CD -> Ref : TryCapture(blocks, whole-area result, …)
    Ref --> CD : clear-sky reference when ≥ 0.9 found
  end
  CD -> CD : cloud = starCloud OR brightnessCloud\n(both unavailable → cloud, fail-safe)
  CD --> Cyc : CloudDetection (CloudAssessment, CapturedReference?)
  deactivate CD
  opt reference captured
    Cyc -> Cyc : use it from now on (this session)
    Cyc -> Host : ReferenceCaptured(reference)\n→ PluginSettingsStore.SaveReference (REQ-57)
  end
  Cyc -> Cyc : NoCloud check = !CloudPresent, reason = Summary
end
@enduml
