@startuml SD04_Hysteresis
!include _style.iuml
title SD-04  Cloud arrives and clears — safety decision (UC-10, UC-03) — REQ-03, REQ-37 … REQ-39

participant ":MonitoringCycle" as Cyc
participant ":SafetyDecisionEngine" as Eng
participant ":SafetyHysteresis" as Hys
participant ":MonitorService" as Svc
participant ":AllskySafetyMonitorDevice" as Dev
participant "NINA" as NINA

== Cloud enters ROI ==
Cyc -> Eng : Decide(conditions[NoCloud = failed])
Eng -> Hys : Apply(conditions, now)
Hys -> Hys : clearSinceUtc = null
Hys --> Eng : safe = false
Eng --> Cyc : Unsafe, "cloud in ROI: 41% of expected stars"
Cyc --> Svc : snapshot
Svc -> Dev : SnapshotAvailable
Dev -> NINA : PropertyChanged(IsSafe = false)
note right : Immediate (REQ-38)

== Sky clears ==
loop each cycle while all conditions pass
  Cyc -> Eng : Decide(conditions[all passed])
  Eng -> Hys : Apply(conditions, now)
  alt first clear cycle
    Hys -> Hys : clearSinceUtc = now
  end
  Hys --> Eng : safe = false, secondsToSafe = 240 − elapsed
  Eng --> Cyc : Unsafe, "clear — safe in 2:10"
end

== 4 minutes clear ==
Cyc -> Eng : Decide(conditions[all passed])
Eng -> Hys : Apply(conditions, now)
Hys --> Eng : safe = true
Eng --> Cyc : Safe  (Untuned flag set while thresholds untuned, REQ-43)
Cyc --> Svc : snapshot
Svc -> Dev : SnapshotAvailable
Dev -> NINA : PropertyChanged(IsSafe = true)
note right : Only after SafeAfterMin [4] (REQ-39)
@enduml
