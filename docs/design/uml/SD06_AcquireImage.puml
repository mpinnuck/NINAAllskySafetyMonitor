@startuml SD06_AcquireImage
!include _style.iuml
title SD-06  Acquire Allsky image — direct (SFTP) source (UC-06) — REQ-11 … REQ-18, REQ-51 … REQ-53

participant ":ImageAcquirer" as Acq
participant ":ImageSourceFactory" as Fac
participant ":SftpImageSource" as Src
participant ":SftpConnector" as Con
participant ":HostKeyVerifier" as HK
participant ":ICredentialStore" as Cred
participant "Allsky Pi\n(allsky.local)" as Pi
participant ":JpegIntegrityChecker" as Chk

Acq -> Fac : For(settings.Kind)  [Direct]
Fac --> Acq : SftpImageSource
Acq -> Src : FetchAsync(force, ct)  [whole fetch limited to TimeoutS, REQ-51]
activate Src
Src -> Con : Connect(direct, TimeoutS / 2)
activate Con
opt password authentication
  Con -> Cred : GetSecret("sftp-password")  (REQ-53)
end
Con -> Con : request host-key type ecdsa-sha2-nistp256 only
Con -> Pi : connect allsky.local:22
alt host can't be reached
  Con -> Pi : connect 192.168.1.110:22 (REQ-13)
end
Pi --> Con : host key
Con -> HK : Verify(SHA256 fingerprint)
alt fingerprint mismatch
  HK --> Con : false
  Con --> Src : HostKeyMismatchException
  Src --> Acq : Failed, Untrusted
  Acq -> Acq : discard earlier images too (REQ-52)
else match
  HK --> Con : true
  Con -> Pi : authenticate (key file / password, REQ-12)
  Con --> Src : session
end
deactivate Con
Src -> Pi : stat /home/pi/allsky/tmp/allsky.jpg
Pi --> Src : mtime
alt mtime unchanged since last fetch and not forced
  Src --> Acq : Unchanged (REQ-16)
  Acq -> Acq : LastSuccessUtc = now
else new image
  Src -> Pi : download
  Pi --> Src : bytes
  Src --> Acq : NewImage(SkyImage, captureTime = mtime, REQ-15)
end
deactivate Src

opt NewImage
  loop up to IncompleteRetries [3]
    Acq -> Chk : IsComplete(bytes)
    alt missing FFD9 end marker
      Chk --> Acq : false
      Acq -> Acq : wait IncompleteRetryS [5 s];\nFetchAsync(force = true) (REQ-17)
    else complete
      Chk --> Acq : true
      Acq -> Acq : LatestImage = image\nLastSuccessUtc = now
    end
  end
end
note over Acq : ImageFreshnessEvaluator fails FreshImage when there is no image, the image is\nmore than StaleAfterMin old, or nothing has been fetched for FetchFailUnsafeMin (REQ-15, REQ-18).\nWeb source: base URL + allsky.jpg, Last-Modified as capture time, If-Modified-Since.
@enduml
