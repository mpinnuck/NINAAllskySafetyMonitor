@startuml CL10a_PluginNina
!include _style.iuml
title CL-10a  NINAAllskySafetyMonitor.Plugin.Nina — NINA integration and adapters

package "NINA (external)" <<external>> {
  abstract class PluginBase
  interface "IEquipmentProvider<ISafetyMonitor>" as IEP
  interface ISafetyMonitor {
    +IsSafe : bool
  }
  interface ITelescopeMediator {
    +GetInfo() : TelescopeInfo
  }
  interface IProfileService
  abstract class BaseINPC
}

package "NINAAllskySafetyMonitor.Plugin.Nina" {
  class AllskySafetyPlugin <<Export(IPluginManifest)>> {
    +Settings : SettingsViewModel
    +Teardown() : Task
    .. REQ-46 REQ-48 ..
  }
  class AllskySafetyMonitorProvider <<Export(IEquipmentProvider)>> {
    -profileService : IProfileService
    -telescopeMediator : ITelescopeMediator
    +Name = "Allsky Safety Monitor"
    +GetEquipment() : IList<ISafetyMonitor>
    .. REQ-01 REQ-05 ..
  }
  class AllskySafetyMonitorDevice {
    -host : MonitorHost
    +Id, Name, DisplayName, Category
    +Connected : bool
    +IsSafe : bool
    +Connect(ct) : Task<bool>
    +Disconnect()
    .. REQ-01 REQ-02 REQ-03 REQ-49 ..
  }
  class MonitorHost <<singleton>> {
    +{static} Instance : MonitorHost
    -service : MonitorService?
    +IsRunning : bool
    +CurrentStatus : SafetyStatus
    +LatestSnapshot : MonitorSnapshot?
    +Override : ManualOverride
    +StartAsync(profile, telescopeMediator) : Task
    +StopAsync() : Task
    +event SnapshotAvailable
    +event RunningChanged
    .. REQ-02 REQ-03 REQ-05 ..
  }
  class PluginSettingsStore <<singleton>> {
    +{static} Instance : PluginSettingsStore
    -store : SettingsStore
    +FilePath : string
    +Current : MonitorSettings
    +Save(settings : MonitorSettings)
    +SaveReference(reference : ClearSkyReference?)
    +event Saved
    .. REQ-30 REQ-55 REQ-56 REQ-57 ..
  }
  class NinaMountStateSource {
    -telescope : ITelescopeMediator
    +GetCurrent() : MountState?
    .. REQ-05 REQ-06 REQ-07 ..
  }
  class NinaSiteLocationSource {
    -profile : IProfileService
    +GetCurrent() : SiteLocation?
    .. REQ-04 ..
  }
  class NinaLogSink {
    +Write(level, message)
  }
  class WindowsCredentialStore {
    +GetSecret(key) : string?
    +SetSecret(key, value)
    .. REQ-53 ..
  }
  class CredentialNativeMethods <<static>> {
    CredReadW, CredWriteW,
    CredDeleteW, CredFree (advapi32)
  }
}

package "NINAAllskySafetyMonitor.Astrometry" {
  class NovasAstroCalculator {
    +SunAltitudeDeg(..)
    +MoonPosition(..)
    +MoonIllumination(..)
    +ToHorizontal(..)
    +ToEquatorial(..)
    .. REQ-08 REQ-24 REQ-31 ..
  }
  note bottom of NovasAstroCalculator
    Sun from NINA.Astrometry; RA/Dec ↔ alt/az
    delegated to Core's CoordinateConverter.
  end note
}

interface IAstroCalculator
interface IMountStateSource
IAstroCalculator <|.. NovasAstroCalculator
PluginBase <|-- AllskySafetyPlugin
IEP <|.. AllskySafetyMonitorProvider
ISafetyMonitor <|.. AllskySafetyMonitorDevice
BaseINPC <|-- AllskySafetyMonitorDevice
IMountStateSource <|.. NinaMountStateSource
AllskySafetyMonitorProvider ..> AllskySafetyMonitorDevice : creates
AllskySafetyMonitorDevice --> MonitorHost
WindowsCredentialStore ..> CredentialNativeMethods
MonitorHost ..> WindowsCredentialStore : ports.Credentials
MonitorHost ..> "MonitorServiceBuilder" : builds with adapters
MonitorHost --> "MonitorService" : starts / stops
MonitorHost ..> PluginSettingsStore : () => Current
AllskySafetyPlugin ..> MonitorHost : stops on Teardown
NinaMountStateSource --> ITelescopeMediator
NinaSiteLocationSource --> IProfileService

note bottom of MonitorHost
  One monitor per NINA session. NINA creates the plugin,
  the device and the dock panel separately, so they share
  this instance. Connect → StartAsync builds the ports
  (SystemClock, Nina* adapters, NovasAstroCalculator) and
  MonitorService; Disconnect or NINA closing → StopAsync.
  When stopped, CurrentStatus is unsafe, "Not connected".
  Override lives here, so it survives reconnects but
  not a NINA restart (REQ-40).
end note
note bottom of NinaMountStateSource
  Pulls TelescopeInfo from the mediator when asked (every
  2 s by MountWatcher and once per cycle): connected, AtPark,
  TrackingEnabled, Slewing, RA, Dec, EquatorialSystem, and the
  reported Alt/Az (diagnostics only, REQ-06). Not connected →
  MountState(Connected = false); read error → null (REQ-07).
end note
note bottom of AllskySafetyMonitorDevice
  IsSafe = Connected && host.CurrentStatus.IsSafe.
  Raises PropertyChanged(IsSafe) on each snapshot
  and on every override change.
  Exceptions are logged and never reach NINA.
end note
note bottom of PluginSettingsStore
  %LOCALAPPDATA%\NINAAllskySafetyMonitor\settings.json
  Outside the NINA plugin folder, so reinstalling
  the plugin keeps the settings. Decision logs go
  to ...\NINAAllskySafetyMonitor\Logs.
end note
@enduml
