@startuml CL10b_PluginViewModels
!include _style.iuml
title CL-10b  NINAAllskySafetyMonitor.Plugin — view models and views (MVVM)

package "NINA (external)" <<external>> {
  abstract class DockableVM
  interface IDockableVM
}
package "NINAAllskySafetyMonitor.Plugin.ViewModels" {
  class StatusViewModel <<Export(IDockableVM)>> {
    +Title = "Allsky Safety"
    +AllskyImage : BitmapSource
    +IsConnected, IsSafe : bool
    +IsAssumed : bool  (amber "SAFE (ASSUMED)")
    +CloudAdviceText, CloudAdviceVisible
      e.g. "Cloud likely in ROI · 2 of 9 stars";
      shown when cloud does not decide safety
    +StateText, ReasonText, LastUpdateText
    +ImageInfoText, WeatherInfoText
    +RoiInfoText, MountInfoText
    +ShowOverlay : bool
    +OverlayLegendText
    +OpenViewerCommand
    +CountdownText
    +OverrideModes, OverrideMode
    +OverrideActive, OverrideBanner
    +Metrics : MetricsViewModel
    +History : HistoryChartViewModel
    +UntunedVisible : bool
    .. REQ-40 REQ-43 REQ-45 REQ-58 REQ-59 ..
  }
  class MetricsViewModel {
    +StarsText  "Stars: 9 of 11 found (82%) · cloud below 70% · mag ≤ 4.4"
    +BrightnessText  "Brightness 1.04× clear sky (limit 1.30×) · non-uniformity …"
    +MoonText  "Moon up 34°, 62% lit: …" | "Moon down"
    +ReferenceText  "Clear-sky reference: 2026-11-05 22:14"
    +HasMetrics : bool
    +Update(snapshot?, settings)
    .. REQ-45 ..
  }
  class HistoryChartViewModel {
    -stars, brightness : LineSeries
    -safe : StairStepSeries
    +Model : PlotModel  (OxyPlot, from NINA)
    +Add(snapshot?)
    tonight only (restarts each night, this session),
    against local time
    .. REQ-45 ..
  }
  class SettingsViewModel {
    -edit : MonitorSettings  (copy)
    +bound property per configurable value
    +SettingsFilePath : string
    +Message : string
    +SftpPassword, PasswordStatus
    +SaveCommand, RevertCommand
    +TestImageCommand, TestWeatherCommand
    +working area, ROI, mount interval, fit limits,
     hand-entered lens fields
    +CalibrateFromFrameCommand (file picker)
    +CalibrateFromCurrentImageCommand
    +EditOutlineCommand
    +CalibrationStatusText
    +CalibrationMessage  (under the buttons)
    +cloud thresholds, CloudTuned, tuning mode fields
    +UndeterminedIsSafe
    +ReferenceStatusText
    +ClearReferenceCommand
    .. REQ-22 REQ-23 REQ-27 REQ-46 REQ-53 REQ-55 REQ-58 ..
  }
  class ImageViewerViewModel {
    +Mode : View | Calibration
    +Image : BitmapSource
    +Zoom, PanX, PanY
    +CursorText  "alt 47.3° az 212.8°"
    +ShowWorkingArea, ShowOutline, ShowRoi,
     ShowCompass, ShowGrid, ShowStars
     (calibration: catalogue stars; view: expected stars)
    +CloseOnOutsideClick : bool  (View only)
    .. REQ-21 REQ-59 ..
  }
  class CalibrationViewModel {
    -session : LensCalibrationSession
    -frame : CalibrationFrame
    +FitCommand
    +IdentifyStarsCommand  (pick named star, click it)
    +DrawOutlineCommand, ClearOutlineCommand
    +Outline : ObservableCollection<PixelPoint>
    +ResultText  "33 stars, 2.7 px (0.15°)"
    +Warnings
    +SaveCommand, CancelCommand
    .. REQ-19 REQ-20 REQ-21 REQ-22 REQ-47 REQ-57 ..
  }
  class OverlayImageComposer <<Plugin.Imaging>> {
    +Compose(image, originalWidth, lens, content : OverlayContent) : BitmapSource
    .. REQ-21 REQ-22 REQ-23 REQ-45 ..
  }
  class OverlayContent <<record>> {
    +WorkingArea, Roi, Compass, Grid
    +Stars, DraftOutline, Picks
    +CloudStars : (PixelPoint, Found)[]  green / red
  }
  class WpfFrameDecoder <<Plugin.Imaging>> {
    +Decode(jpeg) : GrayFrame
    .. REQ-20 ..
  }
  class JpegBitmap <<static>> {
    +Load(jpeg, decodeWidth?) : BitmapSource
    +Size(jpeg) : (int, int)
  }
  class DelegateCommand {
    +Execute(parameter)
    +CanExecute(parameter) : bool
  }
}

package "NINAAllskySafetyMonitor.Plugin.Views" {
  class PasswordBoxAssistant <<static>> {
    +BoundPassword : attached string
  }
  class StatusTemplates <<XAML ResourceDictionary>> {
    "...StatusViewModel_Dockable"
  }
  class OptionsTemplates <<XAML ResourceDictionary>> {
    "Allsky Safety Monitor_Options"
    + "Cloud decides safety" switch and the
      small-count settings (Cloud detection)
  }
  class ImageViewerWindow <<WPF Window>> {
    owned by NINA's main window, ~90% of it
    mouse wheel = zoom, drag = pan
  }
}
class AllskySafetyPlugin
class PluginSettingsStore
class MonitorHost
class SettingsValidator

DockableVM <|-- StatusViewModel
IDockableVM <|.. DockableVM
StatusViewModel --> MetricsViewModel
StatusViewModel --> HistoryChartViewModel
StatusViewModel --> OverlayImageComposer
StatusTemplates ..> StatusViewModel
OptionsTemplates ..> SettingsViewModel
ImageViewerWindow ..> ImageViewerViewModel
ImageViewerViewModel o-- CalibrationViewModel : Calibration mode
ImageViewerViewModel --> OverlayImageComposer
OverlayImageComposer ..> OverlayContent
SettingsViewModel ..> WpfFrameDecoder : IFrameDecoder
StatusViewModel ..> ImageViewerWindow : click image (View mode)
SettingsViewModel ..> ImageViewerWindow : calibrate / edit outline\n(Calibration mode)
AllskySafetyPlugin --> SettingsViewModel
SettingsViewModel --> PluginSettingsStore
SettingsViewModel ..> SettingsValidator
SettingsViewModel ..> DelegateCommand
OptionsTemplates ..> PasswordBoxAssistant : SFTP password
StatusViewModel ..> MonitorHost : SnapshotAvailable,\nRunningChanged

note bottom of StatusTemplates
  Views are DataTemplates exported as
  [Export(typeof(ResourceDictionary))].
  NINA matches them by key: "<plugin name>_Options"
  for the options page, "<view-model type>_Dockable"
  for the dock panel.
end note
note bottom of SettingsViewModel
  Edits a copy of the saved settings. Save validates,
  then saves; Revert discards unsaved edits.
end note
note bottom of ImageViewerWindow
  Opened after the click has finished. View mode: latest
  image + overlay; an outside click or Esc closes it (once,
  deferred; focus loss in the first 0.6 s and while closing
  is ignored). Every handler catches its own errors. Calibration mode: chosen frame, fit
  result, star circles and alt/az grid; closes only with
  Save or Cancel, so a stray click can't lose an outline.
  Cursor alt/az from LensProjection.ToHorizontal (REQ-59).
end note
note right of StatusViewModel
  Snapshots arrive on a background thread
  and are marshalled to the UI dispatcher.
end note
@enduml
