@startuml CL02_Domain
!include _style.iuml
title CL-02  Core.Domain — value objects (immutable records and record structs)

package "NINAAllskySafetyMonitor.Core.Domain" {
  class SkyImage <<record>> {
    +JpegBytes : byte[]
    +CaptureTimeUtc : DateTime
    +Source : ImageSourceKind
    .. REQ-11 REQ-15 ..
  }
  class GrayFrame <<record>> {
    +Width : int
    +Height : int
    +Pixels : float[]
  }
  class SiteLocation <<record>> {
    +LatitudeDeg : double
    +LongitudeDeg : double
    +ElevationM : double
    .. REQ-04 ..
  }
  class MountState <<record>> {
    +Connected : bool
    +AtPark : bool
    +Tracking : bool
    +Slewing : bool
    +RaHours : double?
    +DecDeg : double?
    +Epoch : CoordinateEpoch
    +ReportedAltDeg : double?
    +ReportedAzDeg : double?
    +TimestampUtc : DateTime
    +HasValidPosition : bool
    .. REQ-05 REQ-06 REQ-07 ..
  }
  class HorizontalCoordinate <<record struct>> {
    +AltDeg : double
    +AzDeg : double
  }
  class PixelPoint <<record struct>> {
    +X : double
    +Y : double
  }
  class RegionOfInterest <<record>> {
    +Centre : HorizontalCoordinate?
    +RadiusDeg : double
    +UsesWholeWorkingArea : bool
    +InsideFraction : double
    +Note : string
    +Mask : PixelMask?
    .. REQ-23 REQ-25 REQ-26 REQ-58 ..
  }
  class PixelMask {
    +Width : int
    +Height : int
    +Contains(x : int, y : int) : bool
    +Count : int
    +Bounds : PixelRect?
  }
  class PixelRect <<record struct>> {
    +X, Y, Width, Height : int
    +Inflate(margin, w, h) : PixelRect
  }
  class MoonState <<record>> {
    +Position : HorizontalCoordinate
    +Illumination : double
    +IsUp : bool
    .. REQ-31 ..
  }
  class CatalogueStar <<record>> {
    +Id : int
    +RaHours : double
    +DecDeg : double
    +Magnitude : double
    +Name : string?
  }
  class DetectedStar <<record>> {
    +Position : PixelPoint
    +Flux : double
    +Peak : double
    +AreaPx : int
  }
  class WeatherObservation <<record>> {
    +ObservationTimeUtc : DateTime
    +PrecipRateMmH : double
    +WindGustKmH : double
    .. REQ-33 ..
  }
  class CloudAssessment <<record>> {
    +ExpectedStars : int
    +DetectedStars : int
    +StarFraction : double?
    +RelativeBrightness : double?
    +UniformityRatio : double?
    +StarTestInconclusive : bool
    +BrightnessTestSkipped : bool
    +CloudPresent : bool
    +Summary : string
    +Expected : IReadOnlyList<PixelPoint>
    +Found : IReadOnlyList<bool>
    +Moon : MoonState?
    .. REQ-28 REQ-45 ..
  }
  class ConditionCheck <<record>> {
    +Condition : SafetyCondition
    +Passed : bool
    +Reason : string
    +Undetermined : bool
    +{static} Unknown(condition, reason) : ConditionCheck
    .. REQ-37 REQ-50 ..
  }
  class SafetyConditions <<record>> {
    +Checks : IReadOnlyList<ConditionCheck>
    +AllPassed : bool
    +Failures : IEnumerable<ConditionCheck>
    +OnlyUndeterminedFailures : bool
    +Deciding(cloudDecidesSafety) : SafetyConditions
      without FreshImage and NoCloud when false
    .. REQ-28 REQ-37 REQ-50 ..
  }
  class SafetyStatus <<record>> {
    +State : SafetyState
    +IsSafe : bool
    +Reason : string
    +SecondsToSafe : int?
    +Override : OverrideMode
    +Untuned : bool
    +TimestampUtc : DateTime
    +Assumed : bool
    .. REQ-03 REQ-39 REQ-40 REQ-43 REQ-45 REQ-50 ..
  }
  class MonitorSnapshot <<record>> {
    +Image : SkyImage?
    +Roi : RegionOfInterest?
    +Cloud : CloudAssessment?
    +Weather : WeatherObservation?
    +Conditions : SafetyConditions
    +Status : SafetyStatus
    +Mount : MountState?
    +NotASkyFrame : bool  (UI shows it without overlay)
    .. REQ-41 REQ-45 REQ-60 ..
  }

  enum SafetyState {
    Starting
    Idle
    Safe
    Unsafe
  }
  enum SafetyCondition {
    ActiveWindow
    FreshImage
    NoCloud
    NoRain
    WindBelowLimit
    WeatherCurrent
  }
  enum OverrideMode {
    Auto
    ForceSafe
    ForceUnsafe
  }
  enum ImageSourceKind {
    Web
    Direct
    Replay
  }
  enum CoordinateEpoch {
    JNow
    J2000
  }
}

RegionOfInterest *-- HorizontalCoordinate
RegionOfInterest *-- PixelMask
DetectedStar *-- PixelPoint
SafetyConditions *-- "1..*" ConditionCheck
ConditionCheck --> SafetyCondition
SafetyStatus --> SafetyState
SafetyStatus --> OverrideMode
SkyImage --> ImageSourceKind
MountState --> CoordinateEpoch
MonitorSnapshot o-- SkyImage
MonitorSnapshot o-- RegionOfInterest
MonitorSnapshot o-- CloudAssessment
CloudAssessment o-- MoonState
PixelMask ..> PixelRect
MonitorSnapshot o-- WeatherObservation
MonitorSnapshot o-- MountState
MonitorSnapshot *-- SafetyConditions
MonitorSnapshot *-- SafetyStatus
note bottom of ConditionCheck
  Undetermined: failed because it could not be
  determined (no usable image, not a sky frame,
  lens not calibrated, cloud unknown, no current
  weather data), not because something unsafe was
  detected (REQ-50).
end note
@enduml
