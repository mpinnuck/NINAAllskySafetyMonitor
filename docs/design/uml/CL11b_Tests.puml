@startuml CL11b_Tests
!include _style.iuml
title CL-11b  NINAAllskySafetyMonitor.Tests

package "NINAAllskySafetyMonitor.Tests" {
  package "Traceability" as TT {
    class RequirementCoverageTests {
      +RequirementsFileHasRequirements()
      +NoUnknownRequirementIds()
      +EveryRequirementHasImplementation()
      +EveryRequirementHasTest()
      +CoverageReport()
    }
    class RequirementsParser <<static>> {
      +Parse(markdownPath) : IReadOnlyList<RequirementInfo>
    }
    class RequirementTagScanner <<static>> {
      +Scan(folder) : map REQ → files
    }
    class RequirementInfo <<record>> {
      +Id : string
      +Text : string
    }
    class RepositoryPaths <<static>> {
      +Root : string
      +RequirementsFile : string
    }
  }
  package "Fakes" as TF {
    class FakeClock
    class FakeAstroCalculator
    class FakeSiteLocationSource
    class ListLogSink
    class DelegateCycle
    class FakeImageSource
    class FakeRemoteFileConnector
    class FakeRemoteFileSession
    class FakeCredentialStore
    class FakeHttpHandler
    class FakeWeatherProvider
    class FakeMountStateSource
    class FakeFrameDecoder
    class SyntheticSky <<static>> {
      catalogue at the 20 Oct 2026 frame
      through the fitted lens: spots, frames
    }
    class SyntheticCloudSky <<static>> {
      1000 px frames: clear, thick or thin cloud
      patch, exposure scale, notice image
    }
  }
  class UnitTestFixtures <<namespace>> {
    one test class per Core class, in a folder
    matching the Core package, tagged [Requirement("REQ-xx")]
  }
}

RequirementCoverageTests ..> RequirementsParser
RequirementCoverageTests ..> RequirementTagScanner
RequirementCoverageTests ..> RepositoryPaths
RequirementsParser ..> RequirementInfo
UnitTestFixtures ..> TF

note bottom of RequirementTagScanner
  Scans source files for [Requirement(...)] rather
  than reflecting over assemblies, so it also covers
  the Windows-only Plugin and Astrometry projects
  when the tests run on the Mac.
end note
@enduml
