{
  "folders": [
    { "name": "review tool", "path": "." },
    { "name": "review tests", "path": "../../tests/review" }
  ],
  "settings": {
    "git.openRepositoryInParentFolders": "always",
    "python.defaultInterpreterPath": "${workspaceFolder:review tool}/.venv/bin/python",
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": ["${workspaceFolder:review tests}"]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Review run2",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:review tool}/review.py",
        "args": ["${userHome}/AllskyFrames/Replay/run2"],
        "console": "integratedTerminal"
      }
    ]
  }
}
