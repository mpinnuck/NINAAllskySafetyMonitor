    <OutputType>Exe</OutputType>
    <RootNamespace>NINAAllskySafetyMonitor.Harness</RootNamespace>
    <AssemblyName>NINAAllskySafetyMonitor.Harness</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NINAAllskySafetyMonitor.Core\NINAAllskySafetyMonitor.Core.csproj" />
    <ProjectReference Include="..\..\src\NINAAllskySafetyMonitor.Astrometry\NINAAllskySafetyMonitor.Astrometry.csproj" />
  </ItemGroup>
</Project>
